VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ADK Multi-Agent Backend Configuration
# The URL for the ADK chatbot backend service
VITE_ADK_API_URL=http://localhost:8000

# ============================================================================
# DEMO MODE - ENABLED BY DEFAULT FOR QUICK START
# ============================================================================
# Set to "true" to bypass authentication and use mock data
# - No backend required
# - No login required - directly access dashboard
# - All features work with client-side mock data
#
# Set to "false" for production with real Supabase auth
VITE_DEMO_MODE=true
