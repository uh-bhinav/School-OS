# API Base URL - Empty string enables MSW (Mock Service Worker) to intercept requests
# MSW will handle all API calls with mock data when this is empty
# To test with real backend, set this to: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ✅ Chatbot Configuration (for MSW mock agent)
VITE_ENABLE_MOCKS=true

# ✅ DEMO MODE - Use local mock data for all post-login features
# When enabled:
# - Login remains REAL (Supabase auth)
# - /profiles/me remains REAL (after login)
# - /schools/{id}/config remains REAL (after login)
# - Everything else uses CLIENT-SIDE MOCK DATA
# Set to "true" to enable demo mode, "false" to use real backend
VITE_DEMO_MODE=true

# ADK Multi-Agent Backend Configuration
# The URL for the ADK chatbot backend service
VITE_ADK_API_URL=http://localhost:8004
