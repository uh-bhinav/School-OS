# API Base URL - Empty string enables MSW (Mock Service Worker) to intercept requests
# MSW will handle all API calls with mock data when this is empty
# To test with real backend, set this to: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ✅ Chatbot Configuration (for MSW mock agent)
VITE_ENABLE_MOCKS=true

# ============================================================================
# DEMO MODE - TOGGLE THIS TO ENABLE/DISABLE REAL AUTH
# ============================================================================
# When VITE_DEMO_MODE=true:
# - Login is BYPASSED (auto-login with mock user)
# - All API calls use mock data
# - Good for UI development without backend
#
# When VITE_DEMO_MODE=false (PRODUCTION MODE):
# - Login uses REAL Supabase Auth (signInWithPassword)
# - /profiles/me calls REAL backend
# - Route protection is ENFORCED
# - Sessions are persisted and refreshed automatically
#
# SET TO "false" TO RE-ENABLE REAL AUTHENTICATION
VITE_DEMO_MODE=true

# ADK Multi-Agent Backend Configuration
# The URL for the ADK chatbot backend service
VITE_ADK_API_URL=http://localhost:8004
